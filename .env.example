# Copy to .env.local and fill in when ready. Nothing here is required for
# `next build` to succeed — routes that need a var degrade gracefully
# (forms log a warning instead of emailing; Donate falls back to /contact)
# until it's set.

# --- Resend (contact form, speaker booking form, newsletter signups) ---
# API key from resend.com
RESEND_API_KEY=
# Inbox that should receive all three forms' submissions
CONTACT_TO_EMAIL=
# Optional: a verified sending address, e.g.
#   "TBHE Website <notifications@thebeautifullyhumaneducator.com>"
# Falls back to Resend's shared sandbox sender (onboarding@resend.dev) if unset.
RESEND_FROM_EMAIL=

# --- Square (Mission 139 "Donate" button) ---
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# "sandbox" (default) or "production"
SQUARE_ENVIRONMENT=sandbox

# --- Site ---
# Used by sitemap.xml/robots.txt. Set to the real production domain once one exists.
NEXT_PUBLIC_SITE_URL=https://tbhe-website.vercel.app

# --- Custom admin dashboard (/admin) ---
# Sanity API token with "Editor" access (create at manage.sanity.io ->
# API -> Tokens, or via `npx sanity manage`). Required for /admin to read
# and write content; without it every /admin page shows a setup notice.
SANITY_API_WRITE_TOKEN=
# The password required to log into /admin. Change this to your own value.
ADMIN_PASSWORD=
# Random string used to sign the admin login session cookie. Generate one
# with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
