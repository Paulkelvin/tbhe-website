# Copy to .env.local and fill in when ready. Nothing here is required for
# `next build` to succeed — routes that need a var degrade gracefully
# (forms log a warning instead of emailing; Donate falls back to /contact)
# until it's set.

# --- Resend (contact form, speaker booking form, newsletter signups) ---
# API key from resend.com
RESEND_API_KEY=
# Inbox that should receive all three forms' submissions
CONTACT_TO_EMAIL=
# Optional: a verified sending address, e.g.
#   "TBHE Website <notifications@thebeautifullyhumaneducator.com>"
# Falls back to Resend's shared sandbox sender (onboarding@resend.dev) if unset.
RESEND_FROM_EMAIL=

# --- Square (Mission 139 donations — one-time + monthly — and paid
# services like Executive Coaching, once a price is confirmed and set on
# that service in Sanity) ---
# From the Square Developer Dashboard (developer.squareup.com/apps): an
# access token for the app/environment below.
SQUARE_ACCESS_TOKEN=
# From the Square Dashboard -> Account & Settings -> Locations. Payments
# and payment links are created against this location.
SQUARE_LOCATION_ID=
# From Square Developer Dashboard -> your app -> Webhooks -> Subscriptions, for
# a subscription to https://www.tbheducator.com/api/square/webhook with the
# payment.created, payment.updated and refund.updated events.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# "sandbox" (default, for testing with Square's test card numbers) or
# "production" (real charges). Use sandbox until everything is verified.
SQUARE_ENVIRONMENT=sandbox


# --- H.U.M.A.N. website assistant (OpenAI) ---
# API key from platform.openai.com. Without it the chat widget shows a
# friendly "unavailable" state and points visitors to the Contact page.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=
# Optional inbox routing. Each unset address falls back to CONTACT_TO_EMAIL,
# so no inquiry is lost while the branded mailboxes are being set up.
# BHE coaching, consulting, speaking, and general inquiries:
BHE_TO_EMAIL=
# Mission 139 advocacy and general nonprofit inquiries:
MISSION139_TO_EMAIL=
# Mission 139 family aid (restrict access to authorized staff):
MISSION139_FAMILY_TO_EMAIL=
# Donations, sponsorships, and partnerships:
PARTNERSHIPS_TO_EMAIL=
# Send visitors an automatic "we received your message" email after a lead
# is submitted. Set to "false" to turn it off.
ASSISTANT_SEND_ACKNOWLEDGMENT=true


# --- Custom admin dashboard (/admin) ---
# Sanity API token with "Editor" access (create at manage.sanity.io ->
# API -> Tokens, or via `npx sanity manage`). Required for /admin to read
# and write content; without it every /admin page shows a setup notice.
SANITY_API_WRITE_TOKEN=
# The password required to log into /admin. Change this to your own value.
ADMIN_PASSWORD=
# Random string used to sign the admin login session cookie. Generate one
# with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
